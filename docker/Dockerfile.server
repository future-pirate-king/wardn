# Build stage
FROM golang:1.27-alpine AS builder

WORKDIR /workspace

RUN apk add --no-cache git ca-certificates

# Copy go mod files and download dependencies
COPY go.mod go.sum* ./
RUN go mod download

# Copy source and build
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /wardn-server ./cmd/server

# Runtime stage
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /wardn-server /usr/local/bin/wardn-server

ENTRYPOINT ["wardn-server"]
